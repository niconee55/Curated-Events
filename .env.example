APP_ENV=local
TIMEZONE=America/New_York

# Database
# Local SQLite is the default and recommended starting point
DATABASE_URL=sqlite:///./curated_events.sqlite

# Google Calendar
GOOGLE_CREDENTIALS_FILE=./google-credentials.json
GOOGLE_TOKEN_FILE=./token.json
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_NAME=Curated Events

# Discovery
DISCOVERY_DAYS_AHEAD=60
DISCOVERY_DAYS_START_OFFSET=1

# Logging
LOG_LEVEL=INFO
